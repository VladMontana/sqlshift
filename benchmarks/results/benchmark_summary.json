    },
    {
      "id": "Q3_OLAP_GROUP_BY",
      "name": "OLAP Group By Agg",
      "sql": "SELECT status, count(*) AS total_orders, sum(amount) AS total_revenue FROM orders GROUP BY status",
      "description": "Агрегатный отчет с группировкой GROUP BY"
    },
    {
      "id": "Q4_OLAP_WINDOW",
      "name": "OLAP Window Function",
      "sql": "SELECT id, amount, avg(amount) OVER (PARTITION BY customer_id) AS avg_cust_amount FROM orders",
      "description": "Аналитическая оконная функция с партиционированием"
    },
    {
      "id": "Q5_MULTI_JOIN",
      "name": "Multi-table Join (3 tables)",
      "sql": "SELECT o.id, c.name, p.title FROM orders o JOIN customers c ON o.customer_id = c.id JOIN products p ON o.product_id = p.id",
      "description": "Соединение 3 физических таблиц через явные JOIN"
    },
    {
      "id": "Q6_CTE_AGG",
      "name": "Scope CTE Aggregation",
      "sql": "WITH high_orders AS (SELECT * FROM orders WHERE amount > 1000) SELECT customer_id, count(*) AS high_count FROM high_orders GROUP BY customer_id",
      "description": "CTE с фильтрацией и внешней группировкой"
    },
    {
      "id": "Q7_DASHBOARD_COMPLEX",
      "name": "Complex Dashboard",
      "sql": "WITH monthly_sales AS (SELECT date_trunc('month', order_date) AS month, sum(amount) AS total FROM orders GROUP BY 1) SELECT month, total, lag(total) OVER (ORDER BY month) AS prev_month FROM monthly_sales",
      "description": "Сложный дашборд: CTE + date_trunc + группировка + LAG()"
    },
    {
      "id": "Q8_SCALAR_NO_TABLES",
